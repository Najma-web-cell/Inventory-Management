{
  "info": {
    "name": "Inventra API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login (saves token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@inventra.com\",\n  \"password\": \"Admin@123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      }
    },
    {
      "name": "Dashboard stats",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/dashboard/stats",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "dashboard",
            "stats"
          ]
        }
      }
    },
    {
      "name": "List products",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products?page=1&limit=8&search=",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        }
      }
    },
    {
      "name": "Low stock products",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products?low_stock=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        }
      }
    },
    {
      "name": "Stock IN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/stock/adjust",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "stock",
            "adjust"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": 1,\n  \"type\": \"IN\",\n  \"quantity\": 10,\n  \"note\": \"PO #1001\"\n}"
        }
      }
    },
    {
      "name": "Stock OUT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/stock/adjust",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "stock",
            "adjust"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": 1,\n  \"type\": \"OUT\",\n  \"quantity\": 2\n}"
        }
      }
    },
    {
      "name": "Set exact count",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/stock/adjust",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "stock",
            "adjust"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": 1,\n  \"type\": \"ADJUSTMENT\",\n  \"quantity\": 50\n}"
        }
      }
    },
    {
      "name": "Audit logs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/stock/logs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "stock",
            "logs"
          ]
        }
      }
    },
    {
      "name": "List categories",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "categories"
          ]
        }
      }
    },
    {
      "name": "Create category",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "categories"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Networking\",\n  \"description\": \"Routers and switches\"\n}"
        }
      }
    },
    {
      "name": "List suppliers",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/suppliers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "suppliers"
          ]
        }
      }
    },
    {
      "name": "Create supplier",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/suppliers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "suppliers"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"TP-Link\",\n  \"email\": \"sales@tp-link.com\",\n  \"phone\": \"+1 800-555-0300\"\n}"
        }
      }
    },
    {
      "name": "Export valuation CSV",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/export/valuation",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "export",
            "valuation"
          ]
        }
      }
    }
  ]
}